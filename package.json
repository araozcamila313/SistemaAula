{
  "name": "sistema-aula",
  "version": "1.0.0",
  "description": "Proyecto de gestion de aula para apuntes y asignacion de asientos",
  "main": "backend/server.js",
  "scripts": {
    "dev": "node --watch-path=backend --watch-path=public backend/server.js",
    "start": "node backend/server.js",
    "db:setup": "node backend/setup-db.js",
    "test": "node --test tests/validation.test.js && jest pruebas.test.js --runInBand",
    "test:seating": "jest pruebas.test.js --runInBand"
  },
  "keywords": [
    "aula",
    "apuntes",
    "asientos",
    "javascript"
  ],
